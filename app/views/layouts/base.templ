package layouts

import (
	"github.com/daqing/airway/app/assets"
	"github.com/daqing/airway/lib/utils"
)

// Base renders the shared HTML document shell. Page templates wrap their
// content in this component, e.g.:
//
//	@layouts.Base("My Title") {
//		<p>Page body…</p>
//	}
templ Base(title string, description ...string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			if len(description) > 0 {
				<meta name="description" content={ description[0] }/>
				<meta property="og:title" content={ title }/>
				<meta property="og:description" content={ description[0] }/>
				<meta property="og:type" content="website"/>
				<meta name="theme-color" content="#101319"/>
			}
			<style>
			  body {
          position: relative;
          font-family: "Inter", sans-serif;
          padding: 0;
          margin: 0
        }
			</style>
			@assets.Stylesheet()
			if utils.AppConfig().IsLocal {
				<script src={ templ.URL(utils.URLPrefix() + "/assets/livereload.js") } data-ws={ utils.URLPrefix() + "/ws" } defer></script>
			}
			@assets.Scripts()
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
