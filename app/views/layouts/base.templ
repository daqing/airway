package layouts

// Base renders the shared HTML document shell. Page templates wrap their
// content in this component, e.g.:
//
//	@layouts.Base("My Title") {
//		<p>Page body…</p>
//	}
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<style>
			  body {
          position: relative;
          font-family: "Inter", sans-serif;
          padding: 0;
          margin: 0
        }
			</style>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
