package home

templ interactions() {
	<script>
		(() => {
			document.querySelectorAll(".home-page [data-tabs]").forEach(group => {
				const tabs = Array.from(group.querySelectorAll('[role="tab"]'));
				const activate = tab => {
					tabs.forEach(item => {
						const selected = item === tab;
						item.setAttribute("aria-selected", String(selected));
						item.tabIndex = selected ? 0 : -1;
						document.getElementById(item.getAttribute("aria-controls")).hidden = !selected;
					});
					const language = group.querySelector(".window-language");
					if (language) language.textContent = { api: "GO", view: "TEMPL", cli: "SHELL" }[tab.dataset.tab];
				};
				tabs.forEach((tab, index) => {
					tab.addEventListener("click", () => activate(tab));
					tab.addEventListener("keydown", event => {
						let next;
						if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
						else if (event.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
						else if (event.key === "Home") next = 0;
						else if (event.key === "End") next = tabs.length - 1;
						else return;
						event.preventDefault();
						activate(tabs[next]);
						tabs[next].focus();
					});
				});
			});
			document.querySelectorAll(".home-page [data-copy]").forEach(button => {
				button.hidden = false;
				let reset;
				button.addEventListener("click", async () => {
					const code = document.getElementById(button.dataset.copy);
					const status = button.closest(".quickstart-terminal").querySelector(".copy-status");
					try {
						await navigator.clipboard.writeText(code.textContent);
						button.querySelector("span").textContent = "Copied!";
						status.textContent = "Commands copied. Remember to uncomment the SQLite DSN in .env.";
						clearTimeout(reset);
						reset = setTimeout(() => {
							button.querySelector("span").textContent = "Copy";
							status.textContent = "";
						}, 5000);
					} catch {
						const selection = window.getSelection();
						const range = document.createRange();
						range.selectNodeContents(code);
						selection.removeAllRanges();
						selection.addRange(range);
						status.textContent = "Copy is unavailable here. The commands are selected; press Ctrl+C or ⌘C to copy.";
					}
				});
			});
		})();
	</script>
	<noscript>
		<style>
			.home-page [data-tabs] [role="tabpanel"][hidden] { display: block !important; }
			.home-page [data-tabs] [role="tabpanel"] { border-top: 1px solid #343943; }
			.home-page [role="tablist"] { display: none; }
		</style>
	</noscript>
}
