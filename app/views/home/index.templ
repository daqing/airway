package home

import "github.com/daqing/airway/app/views/layouts"

css indexPage() {
	height: 100vh;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	text-align: center;
}

css titleStyle() {
	color: #9527;
}

css lineStyle() {
	color: #996;
	font-family: "monospace";
}

css nowStyle() {
  margin-top: 15%;
  color: #9E9E9E;
}

// Index renders the landing page (GET /).
templ Index(title string, now string) {
	@layouts.Base("Airway") {
		<div class={ indexPage() }>
			<h1 class={ titleStyle() }>{ title }</h1>
			<p class={ lineStyle() }>This page is rendered with the templ template engine.</p>
			<code class={ nowStyle() }>{ now }</code>
		</div>
	}
}
