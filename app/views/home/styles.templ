package home

templ styles() {
	<style>
		html { scroll-behavior: smooth; scroll-padding-top: 32px; }
		.home-page {
			--bg: #101319; --ink: #f3f4ef; --muted: #9a9eaa; --line: #2b303a;
			--lime: #c2f16b; --lime-ink: #c2f16b; --dot-halo: #c2f16b0c; --hairline: #ffffff09;
			--navlink: #b7bac3; --outline: #3b404a; --outline-bg: #ffffff06;
			--strong: #d4d6db; --lead: #c6c8ce; --meta: #a3a8af;
			--hero-glow: #bce16b0b; --orbit-line: #c2f16b22;
			--panel: #171b23; --panel-line: #343943; --panel-2: #141820; --panel-3: #1b2029;
			--panel-shadow: #0005; --panel-sunken: #14181f; --window-head: #8e94a1; --dot: #505661;
			--code: #d5d9e2; --syn-comment: #8e97a7; --syn-purple: #c0a4ea; --syn-blue: #95c9ea; --syn-green: #c2df93;
			--stack: #aeb3bd; --stack-strong: #d2d5d9;
			--dim: #989fa9; --copy: #a5aab5;
			--tab: #adb2bd; --tab-sel-bg: #c2f16b13; --tab-sel-line: #c2f16b26;
			--env: #9ba3b1; --env-dim: #929aaa; --dash-line: #39404b;
			--qs-bg: #191e1b; --qs-line: #c2f16b12; --step-num: #9eaf8d; --step-text: #a1aaa2;
			--term-bg: #101613; --term-line: #394339; --term-inner: #2d362f; --term-shadow: #0002;
			--term-head: #bfc8bd; --copy-line: #3b453c; --copy-bg: #202820; --copy-text: #c6cebf;
			--term-code: #dbe1d5; --term-comment: #8e9e8c;
			--term-foot: #a6b39e; --term-foot-bg: #c2f16b04; --term-strong: #d4e6c1; --term-req: #9ca895;
			--community: #a2a8b1; --backtop: #a8b19a;
			color-scheme: dark;
			background: var(--bg); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; overflow: clip;
			transition: background-color .25s ease, color .25s ease;
		}
		.home-page[data-theme="light"] {
			--bg: #fafaf7; --ink: #232820; --muted: #6d7369; --line: #dfe2d7;
			--lime-ink: #5d763c; --dot-halo: #5d763c1a; --hairline: #23282012;
			--navlink: #5a6058; --outline: #c6cbba; --outline-bg: #23282008;
			--strong: #3f463c; --lead: #454b43; --meta: #6d7369;
			--hero-glow: #a8c86a1f; --orbit-line: #8ba65c4d;
			--panel: #ffffff; --panel-line: #dfe2d7; --panel-2: #f2f4ec; --panel-3: #ffffff;
			--panel-shadow: #353b2818; --panel-sunken: #f0f2e8; --window-head: #7a8072; --dot: #c9cec0;
			--code: #3c434e; --syn-comment: #7d8471; --syn-purple: #7c5cbf; --syn-blue: #3d6ea5; --syn-green: #4c7a34;
			--stack: #666c60; --stack-strong: #3f463c;
			--dim: #9aa091; --copy: #6d7369;
			--tab: #5a6058; --tab-sel-bg: #5d763c14; --tab-sel-line: #5d763c33;
			--env: #6d7369; --env-dim: #8a9082; --dash-line: #d3d7c6;
			--qs-bg: #edf1e2; --qs-line: #d8e3b8; --step-num: #7c8c68; --step-text: #6d7369;
			--term-bg: #ffffff; --term-line: #dfe2d7; --term-inner: #e4e7da; --term-shadow: #353b2814;
			--term-head: #5a6058; --copy-line: #dfe2d7; --copy-bg: #f0f2ea; --copy-text: #4a5049;
			--term-code: #3c434e; --term-comment: #7d8471;
			--term-foot: #6d7369; --term-foot-bg: #c2f16b1f; --term-strong: #3f4a37; --term-req: #6d7369;
			--community: #6d7369; --backtop: #7c8c68;
			color-scheme: light;
		}
		@media (prefers-color-scheme: light) {
			.home-page:not([data-theme="dark"]) {
				--bg: #fafaf7; --ink: #232820; --muted: #6d7369; --line: #dfe2d7;
				--lime-ink: #5d763c; --dot-halo: #5d763c1a; --hairline: #23282012;
				--navlink: #5a6058; --outline: #c6cbba; --outline-bg: #23282008;
				--strong: #3f463c; --lead: #454b43; --meta: #6d7369;
				--hero-glow: #a8c86a1f; --orbit-line: #8ba65c4d;
				--panel: #ffffff; --panel-line: #dfe2d7; --panel-2: #f2f4ec; --panel-3: #ffffff;
				--panel-shadow: #353b2818; --panel-sunken: #f0f2e8; --window-head: #7a8072; --dot: #c9cec0;
				--code: #3c434e; --syn-comment: #7d8471; --syn-purple: #7c5cbf; --syn-blue: #3d6ea5; --syn-green: #4c7a34;
				--stack: #666c60; --stack-strong: #3f463c;
				--dim: #9aa091; --copy: #6d7369;
				--tab: #5a6058; --tab-sel-bg: #5d763c14; --tab-sel-line: #5d763c33;
				--env: #6d7369; --env-dim: #8a9082; --dash-line: #d3d7c6;
				--qs-bg: #edf1e2; --qs-line: #d8e3b8; --step-num: #7c8c68; --step-text: #6d7369;
				--term-bg: #ffffff; --term-line: #dfe2d7; --term-inner: #e4e7da; --term-shadow: #353b2814;
				--term-head: #5a6058; --copy-line: #dfe2d7; --copy-bg: #f0f2ea; --copy-text: #4a5049;
				--term-code: #3c434e; --term-comment: #7d8471;
				--term-foot: #6d7369; --term-foot-bg: #c2f16b1f; --term-strong: #3f4a37; --term-req: #6d7369;
				--community: #6d7369; --backtop: #7c8c68;
				color-scheme: light;
			}
		}
		.home-page *, .home-page *::before, .home-page *::after { box-sizing: border-box; }
		.home-page [hidden] { display: none !important; }
		.home-page a { color: inherit; text-decoration: none; }
		.home-page button { font: inherit; cursor: pointer; }
		.home-page a, .home-page button { -webkit-tap-highlight-color: transparent; }
		.home-page :is(a, button, [tabindex]):focus-visible { outline: 2px solid #82a940; outline-offset: 5px; }
		.home-page ::selection { background: var(--lime); color: #101319; }
		.home-page svg { flex-shrink: 0; vertical-align: middle; }
		.home-page h1, .home-page h2, .home-page h3, .home-page p { margin: 0; }
		.home-page pre, .home-page code { font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace; }
		.home-page pre { margin: 0; overflow-x: auto; tab-size: 4; }
		.container { width: min(1160px, calc(100% - 80px)); margin-inline: auto; }
		.skip-link { position: absolute; top: -100px; left: 20px; z-index: 10; padding: 14px 20px; background: var(--lime); color: #101319 !important; border-radius: 6px; }
		.skip-link:focus { top: 12px; }
		.home-header { border-bottom: 1px solid var(--hairline); }
		.home-nav { display: flex; align-items: center; justify-content: space-between; min-height: 94px; gap: 28px; }
		.home-brand { display: inline-flex; align-items: center; gap: 10px; font-size: 27px; font-weight: 750; letter-spacing: -1.4px; }
		.brand-mark { color: var(--lime); }
		.brand-period { color: var(--lime-ink); }
		.home-nav-links { display: flex; gap: 34px; align-items: center; margin-left: 65px; }
		.home-nav-side { display: flex; align-items: center; gap: 12px; }
		.home-nav-links a, .home-footer nav a { display: inline-flex; align-items: center; gap: 5px; color: var(--navlink); font-size: 13px; transition: color .18s; }
		.home-nav-links a:hover, .home-footer nav a:hover { color: var(--lime-ink); }
		.theme-toggle { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border: 1px solid var(--outline); border-radius: 6px; background: transparent; color: var(--navlink); transition: border-color .18s, color .18s; }
		.theme-toggle:hover { border-color: var(--lime-ink); color: var(--lime-ink); }
		.theme-toggle svg { width: 16px; height: 16px; }
		.theme-toggle .icon-moon { display: none; }
		.home-page[data-theme="light"] .theme-toggle .icon-sun { display: none; }
		.home-page[data-theme="light"] .theme-toggle .icon-moon { display: block; }
		@media (prefers-color-scheme: light) {
			.home-page:not([data-theme="dark"]) .theme-toggle .icon-sun { display: none; }
			.home-page:not([data-theme="dark"]) .theme-toggle .icon-moon { display: block; }
		}
		.button { display: inline-flex; align-items: center; justify-content: center; gap: 11px; padding: 16px 23px; font-size: 14px; font-weight: 650; border-radius: 6px; border: 1px solid transparent; transition: background .18s, border-color .18s, transform .18s; white-space: nowrap; }
		.button-primary { background: var(--lime); color: #192214 !important; box-shadow: 0 3px 0 #a9d453; }
		.button-primary:hover { background: #d2ff86; transform: translateY(-2px); }
		.button-outline { border-color: var(--outline); }
		.button-outline:hover { border-color: var(--lime-ink); background: var(--outline-bg); }
		.button-small { padding: 10px 15px; font-size: 12px; }
		.button-text { padding-inline: 8px; color: var(--strong) !important; }
		.button-text:hover { color: var(--lime-ink) !important; }
		.home-hero { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; padding-block: 98px 93px; }
		.home-hero::before { content: ""; position: absolute; width: 600px; height: 600px; top: -20px; right: -200px; background: radial-gradient(ellipse, var(--hero-glow), transparent 65%); pointer-events: none; }
		.hero-copy, .hero-preview { position: relative; min-width: 0; }
		.eyebrow { display: flex; align-items: center; gap: 9px; color: var(--lime-ink); font-size: 10px; font-weight: 650; letter-spacing: 1.65px; line-height: 1.7; }
		.status-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--lime-ink); flex-shrink: 0; box-shadow: 0 0 0 4px var(--dot-halo); }
		.home-page h1 { margin-top: 28px; font-size: clamp(56px, 5.6vw, 80px); line-height: 1.065; letter-spacing: -4.6px; font-weight: 650; }
		.hero-accent { position: relative; display: inline-block; color: var(--lime-ink); }
		.hero-accent svg { position: absolute; bottom: -13px; left: 0; width: 100%; height: 15px; opacity: .7; }
		.hero-lead { margin-top: 33px !important; font-size: 17px; line-height: 1.7; color: var(--lead); letter-spacing: -.15px; }
		.hero-detail { margin-top: 13px !important; font-size: 14px; line-height: 1.8; color: var(--muted); }
		.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 17px; margin-top: 30px; }
		.hero-meta { display: flex; flex-wrap: wrap; gap: 17px; margin-top: 30px; color: var(--meta); font-size: 10px; }
		.hero-meta span { display: inline-flex; align-items: center; gap: 5px; }
		.hero-meta svg { color: var(--lime-ink); }
		.hero-preview { padding-top: 14px; }
		.preview-orbit { position: absolute; z-index: 0; inset: -28px -26px 15px; border: 1px dashed var(--orbit-line); border-radius: 18px; transform: rotate(-5deg); pointer-events: none; }
		.preview-orbit span { position: absolute; background: var(--bg); padding: 0 9px; font: 8px "SFMono-Regular", Consolas, monospace; letter-spacing: 2px; color: #7f8b6a; transition: background-color .25s ease; }
		.preview-orbit span:first-child { top: -5px; left: 29px; }
		.preview-orbit span:last-child { bottom: -5px; right: 28px; }
		.code-window { position: relative; border: 1px solid var(--panel-line); border-radius: 10px; background: var(--panel); box-shadow: 0 22px 70px var(--panel-shadow); overflow: hidden; transition: background-color .25s ease, border-color .25s ease; }
		.window-heading { height: 45px; display: flex; align-items: center; gap: 18px; padding: 0 17px; border-bottom: 1px solid var(--line); color: var(--window-head); font: 10px "SFMono-Regular", Consolas, monospace; }
		.window-dots { display: flex; gap: 5px; }
		.window-dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--dot); }
		.window-dots i:first-child { background: #c98477; }
		.window-dots i:nth-child(2) { background: #c5ad6d; }
		.window-dots i:nth-child(3) { background: #87a779; }
		.window-language { margin-left: auto; font-size: 9px; letter-spacing: 1px; }
		.code-tabs { display: flex; border-bottom: 1px solid var(--line); background: var(--panel-2); transition: background-color .25s ease; }
		.code-tabs button { display: inline-flex; align-items: center; gap: 7px; padding: 14px 15px; border: 0; border-right: 1px solid var(--line); border-bottom: 2px solid transparent; background: transparent; color: var(--muted); font: 10px "SFMono-Regular", Consolas, monospace; }
		.code-tabs button svg { width: 13px; height: 13px; color: var(--lime-ink); }
		.code-tabs button[aria-selected="true"] { border-bottom-color: var(--lime-ink); color: var(--ink); background: var(--panel-3); }
		.code-tabs button:hover { color: var(--lime-ink); }
		.code-panel { min-height: 334px; }
		.code-panel pre { padding: 23px 24px 20px; font-size: 12px; line-height: 1.85; color: var(--code); }
		.syntax-comment { color: var(--syn-comment); }
		.syntax-purple { color: var(--syn-purple); }
		.syntax-blue { color: var(--syn-blue); }
		.syntax-green { color: var(--syn-green); }
		.code-status { display: flex; align-items: center; justify-content: space-between; padding: 12px 17px; border-top: 1px solid var(--line); color: var(--syn-comment); font: 8px "SFMono-Regular", Consolas, monospace; letter-spacing: .8px; }
		.code-status > span:first-child { display: flex; align-items: center; gap: 8px; }
		.preview-caption { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 23px; color: var(--muted); font-size: 10px; }
		.caption-line { width: 23px; height: 1px; background: #697457; }
		.stack-strip { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 28px 37px; border-top: 1px solid var(--line); color: var(--stack); }
		.stack-label { font-size: 10px; line-height: 1.7; padding-right: 18px; }
		.stack-label strong { color: var(--stack-strong); font-weight: 500; }
		.stack-wordmark { font-size: 26px; font-weight: 600; letter-spacing: -.8px; white-space: nowrap; }
		.go-wordmark { font-size: 31px; font-style: italic; font-weight: 850; letter-spacing: -2px; }
		.go-wordmark span { margin-left: 3px; }
		.stack-symbol { color: #71818c; margin-left: 5px; }
		.templ-wordmark { font-family: Georgia, serif; font-size: 25px; font-weight: 400; }
		.templ-wordmark span { color: #78816e; }
		.stack-divider { height: 30px; width: 1px; background: var(--line); }
		.stack-database { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; }
		.stack-database svg { color: #8b929c; width: 19px; }
		.home-features { background: #f3f4ee; color: #232820; padding-block: 85px 40px; border-block: 1px solid transparent; }
		.home-page[data-theme="light"] .home-features { border-block-color: #e4e7da; }
		@media (prefers-color-scheme: light) { .home-page:not([data-theme="dark"]) .home-features { border-block-color: #e4e7da; } }
		.home-features .eyebrow { color: #67794a; }
		.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 35px; margin-bottom: 43px; }
		.home-page h2 { margin-top: 17px; font-size: clamp(32px, 3.2vw, 43px); line-height: 1.14; font-weight: 600; letter-spacing: -1.8px; }
		.section-heading > p { color: #71766d; font-size: 13px; line-height: 1.85; padding-bottom: 3px; }
		.home-feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }
		.feature-card { display: flex; flex-direction: column; background: #fcfcf8; border: 1px solid #dfe2d7; border-radius: 7px; padding: 27px; transition: border-color .18s, transform .18s; }
		.feature-card:hover { border-color: #a4b28b; transform: translateY(-3px); }
		.feature-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
		.feature-icon { display: grid; place-items: center; width: 37px; height: 37px; background: #eaf0dd; border: 1px solid #dce5ca; border-radius: 7px; color: #536641; }
		.feature-icon svg { width: 20px; height: 20px; }
		.feature-number { color: #9a9f90; font: 10px "SFMono-Regular", Consolas, monospace; }
		.feature-card h3 { font-size: 17px; letter-spacing: -.45px; font-weight: 650; }
		.feature-card p { font-size: 12px; color: #6d7369; line-height: 1.85; margin-top: 12px; margin-bottom: 24px; }
		.feature-card a { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 11px; font-weight: 600; }
		.feature-card a:hover { color: #5d763c; }
		.feature-card a .arrow { width: 14px; height: 14px; }
		.framework-note { display: flex; align-items: center; gap: 15px; padding-block: 29px 0; color: #73796e; }
		.framework-note p { font-size: 11px; line-height: 1.8; }
		.framework-note strong { color: #424c39; font-weight: 600; }
		.note-mark { font-size: 22px; color: #7c8c68; }
		.database-section { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 75px; padding-block: 95px; }
		.text-muted { color: var(--dim); }
		.section-copy { font-size: 14px; color: var(--copy); line-height: 1.85; margin-top: 21px !important; max-width: 420px; }
		.inline-link { display: inline-flex; align-items: center; gap: 14px; margin-top: 26px; font-size: 12px; font-weight: 550; color: var(--lime-ink) !important; }
		.inline-link:hover .arrow { transform: translateX(3px); }
		.inline-link .arrow { transition: transform .18s; }
		.database-demo { min-width: 0; border: 1px solid var(--panel-line); border-radius: 8px; background: var(--panel); overflow: hidden; transition: background-color .25s ease, border-color .25s ease; }
		.database-tabs { display: flex; gap: 5px; padding: 11px; border-bottom: 1px solid var(--line); }
		.database-tabs button { flex: 1; border: 1px solid transparent; border-radius: 4px; padding: 10px 9px; background: transparent; color: var(--tab); font-size: 11px; }
		.database-tabs button[aria-selected="true"] { background: var(--tab-sel-bg); color: var(--lime-ink); border-color: var(--tab-sel-line); }
		.database-tabs button:hover { color: var(--lime-ink); }
		.database-env { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 24px 23px 14px; font: 10px "SFMono-Regular", Consolas, monospace; color: var(--env); }
		.database-env span:last-child { font-size: 8px; letter-spacing: 1px; color: var(--env-dim); }
		.database-demo pre { padding: 0 23px 25px; font-size: 11px; line-height: 2; }
		.database-query { display: grid; gap: 10px; margin-inline: 23px; padding-block: 20px; border-top: 1px dashed var(--dash-line); font: 11px "SFMono-Regular", Consolas, monospace; overflow-x: auto; }
		.database-query code { white-space: nowrap; }
		.database-footnote { padding: 14px 23px; border-top: 1px solid var(--line); background: var(--panel-sunken); color: var(--env); font-size: 9px; line-height: 1.7; transition: background-color .25s ease; }
		.quickstart-section { padding-block: 80px; background: var(--qs-bg); border-block: 1px solid var(--qs-line); transition: background-color .25s ease; }
		.quickstart-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 75px; }
		.start-steps { padding: 0; margin: 27px 0 0; list-style: none; }
		.start-steps li { display: flex; gap: 17px; align-items: baseline; padding-block: 11px; }
		.start-steps li > span { color: var(--step-num); font: 10px "SFMono-Regular", Consolas, monospace; }
		.start-steps strong { font-size: 13px; font-weight: 550; }
		.start-steps p { margin-top: 5px; font-size: 11px; color: var(--step-text); line-height: 1.7; }
		.quickstart-terminal { min-width: 0; position: relative; background: var(--term-bg); border: 1px solid var(--term-line); border-radius: 8px; box-shadow: 0 15px 50px var(--term-shadow); transition: background-color .25s ease, border-color .25s ease; }
		.terminal-heading { display: flex; justify-content: space-between; align-items: center; min-height: 54px; padding: 10px 20px; border-bottom: 1px solid var(--term-inner); font-size: 11px; color: var(--term-head); }
		.terminal-heading > span { display: flex; gap: 9px; align-items: center; }
		.copy-button { display: inline-flex; gap: 7px; align-items: center; border: 1px solid var(--copy-line); background: var(--copy-bg); color: var(--copy-text); padding: 7px 10px; border-radius: 4px; font-size: 10px !important; }
		.copy-button:hover { border-color: var(--lime-ink); }
		.quickstart-terminal pre { padding: 25px 23px 30px; font-size: 11px; line-height: 2; color: var(--term-code); }
		.quickstart-terminal .syntax-comment { color: var(--term-comment); }
		.terminal-footer { display: flex; align-items: center; gap: 10px; padding: 18px 23px; border-top: 1px solid var(--term-inner); font-size: 10px; color: var(--term-foot); background: var(--term-foot-bg); }
		.terminal-footer strong { color: var(--term-strong); font-weight: 500; }
		.terminal-footer .arrow { margin-left: auto; color: var(--lime-ink); }
		.terminal-requirement { padding: 15px 23px; border-top: 1px solid var(--term-inner); color: var(--term-req); font-size: 9px; line-height: 1.7; }
		.copy-status { position: absolute; left: 0; top: calc(100% + 12px); color: var(--lime-ink); font-size: 11px; line-height: 1.5; }
		.community-section { display: flex; align-items: center; justify-content: space-between; gap: 35px; padding-block: 76px; }
		.community-section h2 { font-size: 32px; letter-spacing: -1.3px; }
		.community-section p:not(.eyebrow) { margin-top: 16px; color: var(--community); font-size: 13px; line-height: 1.8; }
		.home-footer { display: flex; align-items: center; gap: 27px; padding-block: 27px; border-top: 1px solid var(--line); }
		.home-footer .home-brand { font-size: 21px; }
