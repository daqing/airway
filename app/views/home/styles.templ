		@media (max-width: 1050px) { .container { width: calc(100% - 56px); } .home-hero { gap: 35px; } .home-page h1 { font-size: 62px; letter-spacing: -3.5px; } .home-nav-links { margin-left: 0; gap: 20px; } .hero-lead { font-size: 15px; } .desktop-break { display: none; } .hero-meta { gap: 10px; font-size: 9px; } .code-panel pre { font-size: 10px; padding-inline: 17px; } .code-tabs button { padding-inline: 11px; font-size: 9px; } .stack-strip { gap: 14px; } .stack-label { padding-right: 0; } .stack-database { font-size: 11px; gap: 5px; } .feature-card { padding: 22px; } .feature-card h3 { font-size: 16px; } .database-section, .quickstart-grid { gap: 35px; } .database-demo pre, .database-query, .quickstart-terminal pre { font-size: 10px; } }
		@media (max-width: 800px) { .home-nav { min-height: 80px; } .home-nav-links a:first-child { display: none; } .home-hero { grid-template-columns: 1fr; padding-block: 65px 48px; gap: 65px; } .home-page h1 { font-size: 78px; letter-spacing: -4px; } .hero-lead { font-size: 17px; max-width: 440px; } .hero-detail { max-width: 430px; } .hero-preview { width: min(100%, 570px); margin-inline: auto; } .code-panel pre { font-size: 12px; padding-inline: 24px; } .code-tabs button { font-size: 11px; padding-inline: 16px; } .hero-meta { font-size: 11px; gap: 18px; } .stack-strip { flex-wrap: wrap; justify-content: center; column-gap: 35px; row-gap: 20px; } .stack-label { width: 100%; text-align: center; } .stack-label br { display: none; } .stack-label strong { margin-left: 4px; } .stack-divider { display: none; } .stack-database { font-size: 12px; } .home-features { padding-top: 60px; } .home-feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .section-heading { align-items: flex-start; flex-direction: column; gap: 20px; } .section-heading > p br { display: none; } .database-section, .quickstart-grid { grid-template-columns: 1fr; gap: 35px; } .database-section { padding-block: 60px; } .section-copy { max-width: 550px; } .database-demo pre, .database-query, .quickstart-terminal pre { font-size: 12px; } .quickstart-section { padding-block: 60px 75px; } .community-section { flex-direction: column; align-items: flex-start; padding-block: 60px; } .home-footer { flex-wrap: wrap; gap: 20px; } .home-footer nav { margin-left: 0; } .back-top { margin-left: auto; } }
		@media (max-width: 520px) { .container { width: calc(100% - 36px); } .home-nav { gap: 10px; min-height: 74px; } .home-brand { font-size: 24px; } .home-nav-links { gap: 0; margin-left: auto; } .home-nav-links a { font-size: 11px; } .home-nav-links a:not(:nth-child(2)) { display: none; } .home-nav-side { margin-left: 8px; gap: 8px; } .home-nav-side .button { padding: 9px 11px; } .home-nav-side .button .arrow { display: none; } .theme-toggle { width: 34px; height: 34px; } .home-hero { padding-top: 52px; } .eyebrow { font-size: 8px; letter-spacing: 1.3px; } .home-page h1 { font-size: clamp(51px, 13.3vw, 68px); letter-spacing: -3px; } .hero-lead { font-size: 16px; } .hero-detail { font-size: 13px; } .hero-actions { gap: 12px; } .button { font-size: 12px; padding: 14px 18px; } .button-text { padding-inline: 2px; } .hero-meta { font-size: 9px; gap: 11px; } .hero-meta svg { width: 11px; } .preview-orbit { inset: -22px -8px 15px; transform: rotate(-3deg); } .code-tabs button { font-size: 9px; padding: 13px 10px; } .code-tabs button svg { display: none; } .code-panel pre { font-size: 10px; padding-inline: 15px; } .code-panel { min-height: 295px; } .code-status { font-size: 7px; padding-inline: 12px; } .stack-strip { column-gap: 26px; } .stack-wordmark { font-size: 24px; } .stack-database { font-size: 10px; } .stack-database svg { width: 15px; } .home-page h2 { font-size: 32px; letter-spacing: -1.5px; } .home-feature-grid { grid-template-columns: 1fr; gap: 12px; } .feature-card { padding: 25px; } .feature-card h3 { font-size: 18px; } .feature-card p { font-size: 13px; } .feature-card a { font-size: 12px; } .feature-top { margin-bottom: 20px; } .framework-note { align-items: flex-start; } .database-demo pre, .database-query, .quickstart-terminal pre { font-size: 10px; } .database-env { padding-inline: 17px; } .database-demo pre { padding-inline: 17px; } .database-query { margin-inline: 17px; } .database-env span:last-child { font-size: 7px; } .quickstart-terminal pre { paddin