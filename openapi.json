        ],
        "summary": "Delete a file",
        "operationId": "storage_api.DeleteAction",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "File key; may contain slashes",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The deleted key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
