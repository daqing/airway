package layouts

// Base renders the shared HTML document shell. Page templates wrap their
// content in this component, e.g.:
//
//	@layouts.Base("My Title") {
//		<p>Page body…</p>
//	}
templ Base(title string, description ...string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			if len(description) > 0 {
				<meta name="description" content={ description[0] }/>
				<meta property="og:title" content={ title }/>
				<meta property="og:description" content={ description[0] }/>
				<meta property="og:type" content="website"/>
				<meta name="theme-color" content="#101319"/>
			}
			<style>
			  body {
          position: relative;
          font-family: "Inter", sans-serif;
          padding: 0;
          margin: 0
        }
			</style>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
