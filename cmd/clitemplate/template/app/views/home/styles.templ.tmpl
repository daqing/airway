package home

templ styles() {
	<style>
		html { scroll-behavior: smooth; scroll-padding-top: 32px; }
		.home-page { --ink: #f3f4ef; --muted: #9a9eaa; --line: #2b303a; --lime: #c2f16b; background: #101319; color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; overflow: clip; }
