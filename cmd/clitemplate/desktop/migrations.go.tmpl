package main

import (
	"embed"
	"io/fs"

	{{plugins_imports}}
)

// embeddedMigrations carries the project's SQL migrations, copied from the
// project's db/migrate by `airway desktop:init`.
//
//go:embed all:migrations
var embeddedMigrations embed.FS

// migrationsFS re-roots the embedded files at the fs root, which is what
// lib/migrate expects. boot.New applies them to the desktop database on
// startup.
var migrationsFS, _ = fs.Sub(embeddedMigrations, "migrations")

// pluginsEnabled mirrors whether the project's root plugins.go blank-imports
// any plugin; the matching blank imports above compile the same plugins into
// the desktop binary as into the web binary. Regenerated by
// `airway desktop:init`.
const pluginsEnabled = {{plugins_enabled}}
