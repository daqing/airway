# Preferred database config
# AIRWAY_DB_DSN="postgres://[username]:[password]@[host]:5432/[dbname]"

# MySQL examples
# AIRWAY_DB_DSN="mysql://[username]:[password]@[host]:3306/[dbname]?charset=utf8mb4"
# AIRWAY_DB_DSN="[username]:[password]@tcp([host]:3306)/[dbname]?charset=utf8mb4&parseTime=true"

# SQLite examples
# AIRWAY_DB_DSN="sqlite://./tmp/airway.db"
# AIRWAY_DB_DSN="sqlite://:memory:"

# Redis
# AIRWAY_REDIS="redis://[username]:[password]@[host]:6379/0"

# Listen port
AIRWAY_PORT="1900"

# File storage
# Driver: local | s3 | r2 | cos
STORAGE_DRIVER="local"

# Local storage root dir (driver=local)
STORAGE_ROOT="./data/storage"

# Cloud object storage
# Amazon S3:     STORAGE_DRIVER="s3" STORAGE_REGION="us-east-1"
# Tencent COS:   STORAGE_DRIVER="cos" STORAGE_REGION="ap-guangzhou"
# Cloudflare R2: STORAGE_DRIVER="r2" STORAGE_ENDPOINT="<account_id>.r2.cloudflarestorage.com"
# STORAGE_REGION=""
# STORAGE_ENDPOINT=""   # optional endpoint override; required for r2
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# Public base URL (e.g. CDN). When set, file URLs are built from it instead of presigned URLs
# STORAGE_PUBLIC_URL=""

# Timezone
TZ="Asia/Shanghai"
