# Preferred database config
# AIRWAY_DB_DSN="postgres://[username]:[password]@[host]:5432/[dbname]"

# MySQL examples
# AIRWAY_DB_DSN="mysql://[username]:[password]@[host]:3306/[dbname]?charset=utf8mb4"
# AIRWAY_DB_DSN="[username]:[password]@tcp([host]:3306)/[dbname]?charset=utf8mb4&parseTime=true"

# SQLite examples
# AIRWAY_DB_DSN="sqlite://./tmp/airway.db"
# AIRWAY_DB_DSN="sqlite://:memory:"

# Redis
# AIRWAY_REDIS="redis://[username]:[password]@[host]:6379/0"

# Listen port
AIRWAY_PORT="1900"

# File storage
# Driver: local | s3
STORAGE_DRIVER="local"

# Local storage root dir (driver=local)
STORAGE_ROOT="./data/storage"

# S3-compatible object storage (driver=s3)
# Amazon S3:     S3_ENDPOINT="s3.us-east-1.amazonaws.com" S3_REGION="us-east-1"
# Tencent COS:   S3_ENDPOINT="cos.ap-guangzhou.myqcloud.com" S3_REGION="ap-guangzhou"
# Cloudflare R2: S3_ENDPOINT="<account_id>.r2.cloudflarestorage.com" S3_REGION="auto"
# MinIO:         S3_ENDPOINT="127.0.0.1:9000" S3_USE_SSL="false" S3_PATH_STYLE="true"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_USE_SSL="true"
# S3_PATH_STYLE="false"
# Public base URL (e.g. CDN). When set, file URLs are built from it instead of presigned URLs
# S3_PUBLIC_URL=""

# Timezone
TZ="Asia/Shanghai"
